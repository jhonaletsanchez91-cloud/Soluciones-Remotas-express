<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Soluciones Remotas Express | Ingeniería & Soporte IA</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;700;800;900&family=Figtree:wght@300;400;500;600&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
:root {
  --black:#080810; --surface:#0e0e1a; --surface2:#13131f;
  --border:rgba(59,130,246,0.18);
  --blue:#3b82f6; --blue-bright:#60a5fa;
  --green:#10f985; --green-dim:#0d9b58;
  --text:#e2e8f0; --muted:#64748b;
  --fh:'Barlow Condensed',sans-serif;
  --fb:'Figtree',sans-serif;
  --fm:'JetBrains Mono',monospace;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--black);color:var(--text);font-family:var(--fb);overflow-x:hidden;-webkit-font-smoothing:antialiased}
body::before{content:'';position:fixed;inset:0;z-index:0;
  background-image:linear-gradient(rgba(59,130,246,.04)1px,transparent 1px),linear-gradient(90deg,rgba(59,130,246,.04)1px,transparent 1px);
  background-size:40px 40px;pointer-events:none}
section{position:relative;z-index:1}
.blob{position:absolute;border-radius:50%;filter:blur(90px);pointer-events:none;z-index:0}
.bb{width:420px;height:420px;background:rgba(59,130,246,.12)}
.bg{width:300px;height:300px;background:rgba(16,249,133,.07)}
.wrap{max-width:640px;margin:0 auto;padding:0 20px}
.wrap-w{max-width:1100px;margin:0 auto}

/* ICONS */
.ico{display:inline-flex;align-items:center;justify-content:center}
.ico svg{width:1em;height:1em;fill:currentColor;vertical-align:middle}

/* HEADER */
header{
  position:sticky;top:0;z-index:100;
  background:rgba(8,8,16,.92);backdrop-filter:blur(18px);
  border-bottom:1px solid var(--border);
  padding:13px 16px;
  display:flex;justify-content:space-between;align-items:center
}
.logo{font-family:var(--fh);font-size:clamp(.78rem,3.8vw,1.15rem);font-weight:900;letter-spacing:.03em;text-transform:uppercase;color:#fff;white-space:nowrap}
.logo s{color:var(--green);text-decoration:none}
.badge{font-family:var(--fm);font-size:clamp(.52rem,2.4vw,.63rem);font-weight:700;color:var(--green);border:1px solid var(--green-dim);padding:3px 8px;border-radius:100px;text-transform:uppercase;letter-spacing:.08em;display:flex;align-items:center;gap:5px;flex-shrink:0}
.dot{width:7px;height:7px;background:var(--green);border-radius:50%;animation:pulse 1.8s ease-in-out infinite;flex-shrink:0}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1);box-shadow:0 0 0 0 rgba(16,249,133,.5)}50%{opacity:.8;transform:scale(1.2);box-shadow:0 0 0 6px rgba(16,249,133,0)}}

/* HERO */
#hero{min-height:92vh;display:flex;flex-direction:column;justify-content:center;padding:60px 20px 50px;text-align:center;overflow:hidden}
.hero-tag{display:inline-flex;align-items:center;gap:8px;font-family:var(--fm);font-size:.72rem;color:var(--blue-bright);background:rgba(59,130,246,.1);border:1px solid rgba(59,130,246,.3);padding:6px 14px;border-radius:100px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:24px;animation:fadeUp .6s ease both}
h1{font-family:var(--fh);font-size:clamp(3.2rem,13vw,6rem);font-weight:900;line-height:.95;text-transform:uppercase;color:#fff;animation:fadeUp .7s ease .1s both}
.ab{color:var(--blue-bright)} .ag{color:var(--green);text-shadow:0 0 30px rgba(16,249,133,.5)}
.hero-sub{margin:20px auto 32px;max-width:400px;font-size:1.05rem;line-height:1.6;color:var(--muted);animation:fadeUp .7s ease .2s both}
.ctas{display:flex;flex-direction:column;gap:14px;align-items:center;animation:fadeUp .7s ease .3s both}
.btn-g{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--green);color:#020d07;font-family:var(--fh);font-size:1.15rem;font-weight:800;text-transform:uppercase;letter-spacing:.05em;padding:16px 32px;border-radius:6px;text-decoration:none;box-shadow:0 0 30px rgba(16,249,133,.35),0 4px 20px rgba(0,0,0,.4);transition:all .25s;width:100%;max-width:340px}
.btn-g:hover{transform:translateY(-3px);box-shadow:0 0 50px rgba(16,249,133,.55),0 8px 30px rgba(0,0,0,.4)}
.trust-row{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;font-family:var(--fm);font-size:.68rem;color:var(--muted);margin-top:24px}
.trust-row span{display:flex;align-items:center;gap:5px}
.trust-row .ico{color:var(--blue-bright)}

/* DIVIDER */
.div{height:1px;background:linear-gradient(90deg,transparent,var(--border),transparent)}

/* SECTION */
.slbl{font-family:var(--fm);font-size:.7rem;font-weight:700;color:var(--blue-bright);text-transform:uppercase;letter-spacing:.12em;margin-bottom:10px;display:flex;align-items:center;gap:8px}
.slbl::before{content:'';display:block;width:24px;height:2px;background:var(--blue-bright)}
h2{font-family:var(--fh);font-size:clamp(2.2rem,8vw,3.2rem);font-weight:900;text-transform:uppercase;line-height:1;color:#fff;margin-bottom:14px}
h2 s{color:var(--green);text-decoration:none}
.sdesc{font-size:.97rem;line-height:1.65;color:var(--muted);max-width:480px}

/* TRUST BAR */
#trust{padding:48px 20px;background:var(--surface2);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.tg{display:grid;grid-template-columns:1fr 1fr;gap:24px;max-width:640px;margin:0 auto}
.ti{text-align:center}
.tn{font-family:var(--fh);font-size:2.8rem;font-weight:900;color:var(--green);line-height:1;text-shadow:0 0 20px rgba(16,249,133,.3)}
.tl{font-size:.82rem;color:var(--muted);margin-top:4px}

/* ESTRELLA */
#estrella{padding:80px 0}
.cstar{background:linear-gradient(135deg,rgba(59,130,246,.1),rgba(16,249,133,.06));border:1px solid rgba(59,130,246,.35);border-radius:16px;padding:32px 24px;position:relative;overflow:hidden;box-shadow:0 0 60px rgba(59,130,246,.1)}
.cstar::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--blue),var(--green))}
.sbadge{display:inline-flex;align-items:center;gap:7px;font-family:var(--fm);font-size:.65rem;font-weight:700;background:var(--blue);color:#fff;padding:4px 12px;border-radius:4px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:18px}
.cstar h3{font-family:var(--fh);font-size:2.2rem;font-weight:900;text-transform:uppercase;color:#fff;margin-bottom:10px}
.cdesc{font-size:.95rem;color:var(--muted);margin-bottom:24px;line-height:1.6}
.chk{list-style:none;display:flex;flex-direction:column;gap:10px;margin-bottom:28px}
.chk li{display:flex;align-items:flex-start;gap:10px;font-size:.97rem;color:var(--text)}
.chk li .ico{color:var(--green);margin-top:2px;flex-shrink:0}
.plbl{font-family:var(--fm);font-size:.68rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
.pamt{font-family:var(--fh);font-size:3rem;font-weight:900;color:var(--green);line-height:1;text-shadow:0 0 20px rgba(16,249,133,.4)}
.pamt small{font-size:1.1rem;font-weight:600;color:var(--muted)}
.pnote{font-size:.82rem;color:var(--blue-bright);margin-top:6px;display:flex;align-items:center;gap:6px}

/* CONNECT */
#conectar{padding:80px 0}
.cgrid{display:flex;flex-direction:column;gap:16px}
.ccard{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:22px 20px;display:flex;align-items:center;gap:18px;transition:border-color .25s,transform .25s;position:relative}
.ccard:hover{border-color:var(--blue);transform:translateX(4px)}
.cnum{font-family:var(--fm);font-size:.65rem;font-weight:700;color:var(--blue-bright);position:absolute;top:12px;right:16px;opacity:.5}
.cico{width:52px;height:52px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;flex-shrink:0}
.wa-c{background:rgba(37,211,102,.12);color:#25d366}
.meet-c{background:rgba(66,133,244,.12);color:#4285f4}
.ad-c{background:rgba(255,140,0,.12);color:#ff8c00}
.cinfo h4{font-family:var(--fh);font-size:1.3rem;font-weight:800;text-transform:uppercase;color:#fff;margin-bottom:3px}
.cinfo p{font-size:.88rem;color:var(--muted);line-height:1.5}
.csteps{margin-top:36px;background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:22px 20px}
.csteps h4{font-family:var(--fh);font-size:1.2rem;font-weight:800;text-transform:uppercase;color:var(--blue-bright);margin-bottom:16px;display:flex;align-items:center;gap:8px}
.slist{display:flex;flex-direction:column;gap:12px}
.step{display:flex;align-items:flex-start;gap:14px;font-size:.92rem;color:var(--text);line-height:1.5}
.sn{width:26px;height:26px;border-radius:6px;background:rgba(59,130,246,.15);border:1px solid rgba(59,130,246,.3);font-family:var(--fm);font-size:.72rem;font-weight:700;color:var(--blue-bright);display:flex;align-items:center;justify-content:center;flex-shrink:0}

/* FÍSICOS */
#fisicos{padding:80px 0}
.sgrid{display:flex;flex-direction:column;gap:16px;padding:0 20px}
.scard{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:26px 22px;transition:all .3s;position:relative;overflow:hidden}
.scard::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;transform:scaleX(0);transform-origin:left;transition:transform .35s ease}
.c1::after{background:linear-gradient(90deg,#3b82f6,#60a5fa)}
.c2::after{background:linear-gradient(90deg,#10f985,#0d9b58)}
.c3::after{background:linear-gradient(90deg,#f59e0b,#ef4444)}
.c4::after{background:linear-gradient(90deg,#8b5cf6,#3b82f6)}
.c5::after{background:linear-gradient(90deg,#06b6d4,#3b82f6)}
.scard:hover::after{transform:scaleX(1)}
.scard:hover{border-color:rgba(255,255,255,.15);transform:translateY(-3px)}
.sico{width:48px;height:48px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;margin-bottom:14px}
.si1{background:rgba(59,130,246,.12);color:var(--blue-bright)}
.si2{background:rgba(16,249,133,.1);color:var(--green)}
.si3{background:rgba(245,158,11,.1);color:#f59e0b}
.si4{background:rgba(139,92,246,.1);color:#a78bfa}
.si5{background:rgba(6,182,212,.1);color:#22d3ee}
.scard h4{font-family:var(--fh);font-size:1.35rem;font-weight:800;text-transform:uppercase;color:#fff;margin-bottom:6px}
.scard p{font-size:.88rem;color:var(--muted);line-height:1.55}
.tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
.tag{font-family:var(--fm);font-size:.62rem;font-weight:700;padding:3px 9px;border-radius:4px;text-transform:uppercase;letter-spacing:.06em}
.tb{background:rgba(59,130,246,.12);color:var(--blue-bright);border:1px solid rgba(59,130,246,.2)}
.tg2{background:rgba(16,249,133,.1);color:var(--green);border:1px solid rgba(16,249,133,.2)}
.ta{background:rgba(245,158,11,.1);color:#f59e0b;border:1px solid rgba(245,158,11,.2)}
.tp{background:rgba(139,92,246,.1);color:#a78bfa;border:1px solid rgba(139,92,246,.2)}
.tc{background:rgba(6,182,212,.1);color:#22d3ee;border:1px solid rgba(6,182,212,.2)}

/* EQUIPO */
#equipo{padding:80px 0}
.egrid{display:flex;flex-direction:column;gap:14px}
.ecard{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:22px 20px;display:flex;align-items:center;gap:18px;transition:border-color .25s}
.ecard:hover{border-color:var(--blue)}
.eav{width:54px;height:54px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;flex-shrink:0}
.ea1{background:rgba(59,130,246,.12);color:var(--blue-bright)}
.ea2{background:rgba(245,158,11,.1);color:#f59e0b}
.ea3{background:rgba(139,92,246,.1);color:#a78bfa}
.einfo h4{font-family:var(--fh);font-size:1.25rem;font-weight:800;text-transform:uppercase;color:#fff}
.einfo p{font-size:.85rem;color:var(--muted);line-height:1.5}
.eexp{font-family:var(--fm);font-size:.65rem;color:var(--green);margin-top:4px;display:flex;align-items:center;gap:5px}

/* CTA */
#cta-final{padding:80px 20px;text-align:center}
#cta-final h2{font-size:clamp(2.2rem,9vw,3.5rem);margin-bottom:16px}
#cta-final p{font-size:1rem;color:var(--muted);max-width:380px;margin:0 auto 32px;line-height:1.6}
.ctabts{display:flex;flex-direction:column;align-items:center;gap:14px}
.btn-o{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:transparent;color:var(--blue-bright);font-family:var(--fh);font-size:1rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;padding:13px 28px;border-radius:6px;text-decoration:none;border:1px solid rgba(59,130,246,.4);transition:all .25s;width:100%;max-width:300px}
.btn-o:hover{border-color:var(--blue-bright);background:rgba(59,130,246,.1)}

/* FOOTER */
footer{padding:30px 20px;border-top:1px solid var(--border);text-align:center}
.flogo{font-family:var(--fh);font-size:clamp(.82rem,4vw,1.1rem);font-weight:900;text-transform:uppercase}
.flogo s{color:var(--green);text-decoration:none}
footer p{font-size:.78rem;color:var(--muted);margin-top:8px}
.fst{display:inline-flex;align-items:center;gap:6px;font-family:var(--fm);font-size:.65rem;color:var(--green);margin-top:10px}

/* FAB */
.fab{position:fixed;bottom:22px;right:20px;z-index:200;width:60px;height:60px;border-radius:50%;background:#25d366;display:flex;align-items:center;justify-content:center;text-decoration:none;box-shadow:0 0 25px rgba(37,211,102,.5),0 6px 24px rgba(0,0,0,.4);animation:fl 3s ease-in-out infinite;transition:transform .25s}
.fab:hover{transform:scale(1.12)!important}
.fab svg{width:28px;height:28px;fill:#fff}
@keyframes fl{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
.fablbl{position:fixed;bottom:34px;right:88px;z-index:200;background:var(--surface);border:1px solid var(--border);font-family:var(--fm);font-size:.65rem;font-weight:700;color:var(--green);padding:6px 12px;border-radius:6px;white-space:nowrap;animation:fi 1s ease 2s both;transition:opacity .5s}
.fablbl::after{content:'';position:absolute;right:-7px;top:50%;transform:translateY(-50%);border-left:7px solid var(--border);border-top:6px solid transparent;border-bottom:6px solid transparent}

/* ANIM */
@keyframes fadeUp{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:translateY(0)}}
@keyframes fi{from{opacity:0}to{opacity:1}}
.rv{opacity:0;transform:translateY(28px);transition:opacity .6s ease,transform .6s ease}
.rv.in{opacity:1;transform:translateY(0)}

/* RESPONSIVE */
@media(min-width:600px){
  .sgrid{display:grid;grid-template-columns:1fr 1fr}
  .egrid{display:grid;grid-template-columns:1fr 1fr}
  .tg{grid-template-columns:repeat(4,1fr)}
  .cgrid{display:grid;grid-template-columns:1fr 1fr}
  .ctas,.ctabts{flex-direction:row;justify-content:center}
  .btn-g,.btn-o{width:auto}
}
</style>
</head>
